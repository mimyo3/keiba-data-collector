class PagingAdapter:
    """Adapter class to wrap existing API with pagination functionality."""

    def __init__(self, api_client=None):
        """Initialize the paging adapter with an API client.

        Args:
            api_client: Optional API client to wrap. If None, uses default _get_table_rows.
        """
        self.api_client = api_client or _wrap_api_call

    def get_table_rows(self, table_name: str, page: int = 1, limit: int = 100) -> Dict[str, Any]:
        """Get table rows with pagination.

        Args:
            table_name: The name of the table to query
            page: Page number (1-based)
            limit: Number of rows per page (default: 100)

        Returns:
            Dictionary containing rows and pagination metadata
        """
        # Call the existing API with pagination parameters
        result = self.api_client(table_name, page=page, limit=limit)
        
        # Return the result with additional metadata if needed
        return result

    def get_all_rows_paginated(self, table_name: str, limit: int = 100) -> List[Dict[str, Any]]:
        """Get all rows from a table with pagination.

        Args:
            table_name: The name of the table to query
            limit: Number of rows per page (default: 100)

        Returns:
            List of all rows from the table
        """
        all_rows = []
        page = 1

        while True:
            # Get a page of rows
            result = self.api_client(table_name, page=page, limit=limit)
            
            # Extract rows from the result
            rows = result.get("rows", [])  # Get rows from result dict
            
            # If no more rows, break
            if not rows:
                break
            
            all_rows.extend(rows)
            page += 1

        return all_rows

    def get_page_count(self, table_name: str, limit: int = 100) -> int:
        """Get total number of pages for a table.

        Args:
            table_name: The name of the table to query
            limit: Number of rows per page (default: 100)

        Returns:
            Total number of pages
        """
        # Get the total count from the API
        try:
            # Get the first page and extract the total from headers
            result = self.api_client(table_name, page=1, limit=limit)
            total = result.get("total", 0)
            total_pages = (total + limit - 1) // limit if limit > 0 else 0
            return total_pages
        except Exception:
            return 0

    def get_table_rows_by_page(self, table_name: str, page: int = 1, limit: int = 100) -> Dict[str, Any]:
        """Get table rows with pagination (alternative method).

        Args:
            table_name: The name of the table to query
            page: Page number (1-based)
            limit: Number of rows per page (default: 100)

        Returns:
            Dictionary containing rows and pagination metadata
        """
        # Call the existing API with pagination parameters
        result = self.api_client(table_name, page=page, limit=limit)
        
        # Return the result with additional metadata if needed
        return result

    def get_table_rows_with_pagination(self, table_name: str, page: int = 1, limit: int = 100) -> Dict[str, Any]:
        """Get table rows with pagination and additional metadata.

        Args:
            table_name: The name of the table to query
            page: Page number (1-based)
            limit: Number of rows per page (default: 100)

        Returns:
            Dictionary containing rows and pagination metadata
        """
        # Call the existing API with pagination parameters
        result = self.api_client(table_name, page=page, limit=limit)
        
        # Return the result with additional metadata if needed
        return result
